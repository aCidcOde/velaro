APP_NAME="Velaro"
APP_ENV=development
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Idiomas — a base do codigo e o ingles; o usuario final ve pt-BR ou espanhol via lang/
# Suportados: en (base) · pt_BR · es. O fallback e fixo em "en" no config/app.php.
APP_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_VERSION=1.1
APP_MAINTENANCE_DRIVER=file
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=velaro
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=1860

CACHE_STORE=database
# CACHE_PREFIX=


MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO_ADDRESS="suporte@example.com"
MAIL_REPLY_TO_NAME="${APP_NAME}"


VITE_APP_NAME="${APP_NAME}"
CONTEXT7_API_KEY=

# Google OAuth (Socialite) — lidas por config/services.php
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Agente Velaro IA (local) — lidas por config/services.php; os valores abaixo sao os defaults
AGENT_RESPONSE_DELAY_SECONDS=1
AGENT_WAIT_TIMEOUT=30
AGENT_UPLOAD_MAX_KB=20480
AGENT_POST_MAX_KB=30720
AGENT_UPLOAD_DISK=local
AGENT_UPLOAD_PROCESSED_DIRECTORY=agent-uploads/processed
AGENT_UPLOAD_STALE_PROCESSING_SECONDS=900

# Seed do admin inicial — lidas por database/seeders/DatabaseSeeder.php
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Financeiro do Portal do Lojista — lidas por config/velaro-financeiro.php.
# Chave Pix, CNPJ e conta bancaria NAO tem valor padrao de proposito: sem
# configuracao a tela de pagamento mostra a pendencia, nunca um dado de fachada.
VELARO_INVOICE_DISK=public
VELARO_PAYEE_NAME="Velaro Alianças Indústria e Comércio Ltda"
VELARO_PAYEE_CITY="SAO PAULO"
VELARO_PAYEE_CNPJ=
VELARO_PIX_KEY=
VELARO_BANK_CODE=
VELARO_BANK_NAME=
VELARO_BANK_BRANCH=
VELARO_BANK_ACCOUNT=

# Senha das contas de demonstracao do VelaroSeeder (fora de producao).
# Sem valor aqui, vale o fallback do config/velaro.php.
RESELLER_SEED_PASSWORD=
